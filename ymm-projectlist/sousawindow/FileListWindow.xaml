<Window x:Class="ymm_projectlist.sousawindow.FileListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ymm_projectlist"
        xmlns:c="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
        Title="素材一覧" Height="450" Width="800">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- フォルダー選択 -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,5">
            <TextBlock Text="検索フォルダー:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <c:DirectorySelector Value="{Binding SelectedFolder, Mode=TwoWay}" Width="300" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding TimelineItems}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="チェック" Binding="{Binding IsChecked, Mode=TwoWay}" Width="50"/>
                <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="200"/>
                <DataGridTextColumn Header="パス" Binding="{Binding FullPath}" Width="250"/>
                <DataGridTextColumn Header="状態" Binding="{Binding Status}" Width="120"/>
                <DataGridTemplateColumn Header="再リンク" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="再リンク" 
                                    Command="{Binding DataContext.RelinkCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="プロキシ" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="プロキシ" 
                                    Command="{Binding DataContext.ProxyCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{Binding RowBackground}"/>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- 選択ボタン -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button Content="選択再リンク" Command="{Binding RelinkSelectedCommand}" Margin="5,0"/>
            <Button Content="選択プロキシ" Command="{Binding ProxySelectedCommand}" Margin="5,0"/>
        </StackPanel>
    </Grid>
</Window>
